{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspai.dev/contracts/project-lifecycle-context.v1.json",
  "title": "Workspai Project Lifecycle Context",
  "description": "A bounded, manifest-derived projection of project runtime units and their supported lifecycle commands, or a typed refusal that preserves completeness.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "project",
        "selection",
        "units",
        "omittedUnits",
        "budget"
      ],
      "properties": {
        "schemaVersion": { "const": "workspai.project-lifecycle-context.v1" },
        "status": { "enum": ["ready", "no-lifecycle-units"] },
        "project": { "const": "." },
        "selection": { "$ref": "#/$defs/selection" },
        "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
        "omittedUnits": { "const": 0 },
        "budget": { "$ref": "#/$defs/usedBudget" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status", "project", "selection", "message", "nextActions"],
      "properties": {
        "schemaVersion": { "const": "workspai.project-lifecycle-context.v1" },
        "status": { "enum": ["insufficient-budget", "path-not-mapped"] },
        "project": { "const": "." },
        "selection": { "$ref": "#/$defs/selection" },
        "budget": { "$ref": "#/$defs/requiredBudget" },
        "message": { "type": "string", "minLength": 1 },
        "nextActions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "insufficient-budget" } } },
          "then": { "required": ["budget"] },
          "else": { "not": { "required": ["budget"] } }
        }
      ]
    }
  ],
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode"],
      "properties": {
        "path": { "type": ["string", "null"] },
        "mode": { "enum": ["all-units", "closest-unit"] }
      }
    },
    "usedBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBytes", "usedBytes", "accounting"],
      "properties": {
        "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 65536 },
        "usedBytes": { "type": "integer", "minimum": 1 },
        "accounting": { "const": "utf8-json-with-newline" }
      }
    },
    "requiredBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBytes", "requiredBytes", "accounting"],
      "properties": {
        "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 65536 },
        "requiredBytes": { "type": "integer", "minimum": 1 },
        "accounting": { "const": "utf8-json-with-newline" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "command", "confidence", "preflight"],
      "properties": {
        "stage": { "enum": ["init", "test", "build", "start"] },
        "command": { "type": "string", "minLength": 1 },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "description": "Working directory relative to the canonical selected project root; source reads do not select this directory for terminal commands."
        },
        "confidence": { "enum": ["high", "medium"] },
        "preflight": { "enum": ["executable-and-inputs", "executable"] },
        "focus": { "type": "string", "minLength": 1 },
        "ownerManifest": { "type": "string", "minLength": 1 },
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "args"],
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } }
          }
        },
        "argvSequence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["executable", "args"],
            "properties": {
              "executable": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runtime",
        "ecosystem",
        "role",
        "root",
        "manifest",
        "provenance",
        "stages"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "ecosystem": { "type": "string", "minLength": 1 },
        "role": { "enum": ["production", "tooling", "test", "example"] },
        "root": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "provenance": { "const": "manifest-derived" },
        "workspaceOwner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "manifest", "packageManager"],
          "properties": {
            "root": { "type": "string", "minLength": 1 },
            "manifest": { "type": "string", "minLength": 1 },
            "packageManager": { "enum": ["npm", "pnpm", "yarn", "bun"] }
          }
        },
        "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } }
      }
    }
  }
}
