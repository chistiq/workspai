{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/packages/shared/cli-result/v1",
  "title": "WorkspaiSharedCliResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "status", "exitCode", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "workspai-shared-cli-result.v1" },
    "command": {
      "enum": ["help", "schema-list", "validate", "compatibility"]
    },
    "status": {
      "enum": ["succeeded", "invalid", "unsupported", "failed", "cancelled"]
    },
    "exitCode": { "enum": [0, 1, 3, 130] },
    "diagnostics": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/Diagnostic" }
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "succeeded" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "exitCode": { "const": 0 },
          "diagnostics": { "type": "array", "maxItems": 0 },
          "data": { "type": "object" }
        },
        "required": ["data"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "exitCode": { "const": 1 } }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["invalid", "unsupported"] }
        },
        "required": ["status"]
      },
      "then": {
        "properties": { "exitCode": { "const": 3 } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "cancelled" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "exitCode": { "const": 130 } }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["invalid", "unsupported", "failed", "cancelled"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": { "diagnostics": { "type": "array", "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "phase", "path", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "phase": {
          "enum": [
            "usage",
            "input",
            "resource",
            "structural",
            "semantic",
            "compatibility",
            "internal",
            "cancellation"
          ]
        },
        "path": { "type": "string", "maxLength": 4096 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "keyword": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
