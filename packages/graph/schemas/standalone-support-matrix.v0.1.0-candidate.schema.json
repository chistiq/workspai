{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/graph/standalone-support-matrix/v0.1.0-candidate",
  "title": "WorkspaiGraphStandaloneSupportMatrixCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "maturity",
    "publishable",
    "standaloneStable",
    "publicPreview",
    "centralCliRuntime",
    "nativeAcceleration",
    "defaultMode",
    "workspaceParticipation",
    "network",
    "runtime",
    "platforms",
    "languages",
    "queryCache",
    "externalProviderSdk",
    "publicPreviewMigrations",
    "packedJobs",
    "plannedCapabilities",
    "unsupportedCapabilities",
    "limitations"
  ],
  "properties": {
    "contract": {
      "const": {
        "id": "workspai.graph.standalone-support-matrix",
        "version": "0.1.0-candidate"
      }
    },
    "maturity": { "const": "repository-preview-candidate" },
    "publishable": { "const": false },
    "standaloneStable": { "const": false },
    "publicPreview": { "const": false },
    "centralCliRuntime": { "const": "prohibited" },
    "nativeAcceleration": { "const": "prohibited" },
    "defaultMode": { "const": "project-only" },
    "workspaceParticipation": { "const": "typed-handoff-optional" },
    "network": { "const": "deny" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node"],
      "properties": {
        "node": { "const": ">=20.19.0" }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux", "darwin", "win32"],
      "properties": {
        "linux": { "$ref": "#/$defs/platform" },
        "darwin": { "$ref": "#/$defs/platform" },
        "win32": { "$ref": "#/$defs/platform" }
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "python", "go", "java", "dotnet", "rust", "unsupported"],
      "properties": {
        "node": { "const": "official-offline" },
        "python": { "const": "official-offline" },
        "go": { "const": "official-offline" },
        "java": { "const": "official-offline" },
        "dotnet": { "const": "official-offline" },
        "rust": { "const": "official-offline" },
        "unsupported": { "const": "abstention" }
      }
    },
    "queryCache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultStore",
        "hostPersistence",
        "network",
        "resultEnvelopeCacheField",
        "historicalRetention",
        "latestGenerationAlias",
        "secrets",
        "canonicalReuseIdentity"
      ],
      "properties": {
        "defaultStore": { "const": "none" },
        "hostPersistence": { "const": "injected-only" },
        "network": { "const": "deny" },
        "resultEnvelopeCacheField": { "const": "prohibited" },
        "historicalRetention": { "const": "generation-keyed-until-policy-revocation" },
        "latestGenerationAlias": { "const": "rejected" },
        "secrets": { "const": "redaction-policy-digest-bound" },
        "canonicalReuseIdentity": { "const": "exact-digest" }
      }
    },
    "externalProviderSdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "until"],
      "properties": {
        "status": { "const": "deferred" },
        "until": { "const": "standalone-stable" }
      }
    },
    "publicPreviewMigrations": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "packedJobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1 }
    },
    "plannedCapabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["standalone-stable", "public-preview", "cli-shadow-parity"]
      }
    },
    "unsupportedCapabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["standalone-stable", "public-preview", "cli-runtime-bridge", "native-acceleration"]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "remoteAdmission"],
      "properties": {
        "declared": { "const": true },
        "remoteAdmission": { "const": "pending" }
      }
    }
  }
}
