{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/graph/structural-extractor-profile/v0.1.0-candidate",
  "title": "WorkspaiGraphStructuralExtractorProfileCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "version", "staticOnly", "authority", "derivation", "languages"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "workspai.graph.structural-extractor-profile" },
        "version": { "const": "0.1.0-candidate" }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "staticOnly": { "const": true },
    "authority": { "const": "observed" },
    "derivation": { "const": "extracted" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/language" }
    }
  },
  "$defs": {
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "extensions", "extractions", "unsupportedSyntax"],
      "properties": {
        "language": { "enum": ["node", "python", "go", "java", "dotnet", "rust"] },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" }
        },
        "extractions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["static-imports", "literal-routes"] }
        },
        "unsupportedSyntax": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
        }
      }
    }
  }
}
