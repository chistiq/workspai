{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/graph/binding-profile/v0.1.0-candidate",
  "title": "WorkspaiGraphBindingProfileCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "version", "sourceKinds", "steps", "minimumProof"],
  "properties": {
    "contract": {
      "const": { "id": "workspai.graph.binding-profile", "version": "0.1.0-candidate" }
    },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "sourceKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relations", "direction", "semantics"],
        "properties": {
          "relations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "direction": { "enum": ["outgoing", "incoming", "both"] },
          "semantics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "enum": ["structural", "behavioral", "declarative", "derived"] }
          },
          "targetKinds": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "minimumProof": {
      "enum": ["supported", "corroborated", "verified", "disputed", "insufficient", "unresolved"]
    }
  }
}
