{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/graph/change-set/v0.1.0-candidate",
  "title": "WorkspaiGraphChangeSetCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "inputs", "causes"],
  "properties": {
    "contract": {
      "const": { "id": "workspai.graph.change-set", "version": "0.1.0-candidate" }
    },
    "id": { "type": "string", "minLength": 1 },
    "baseGeneration": { "type": "string" },
    "inputs": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/inputChange" }
    },
    "causes": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/changeCause" }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "inputChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "inputKind", "scanProfileDigest"],
      "properties": {
        "kind": {
          "enum": ["added", "edited", "deleted", "renewed", "rename-candidate"]
        },
        "locator": { "type": "string", "minLength": 1 },
        "inputKind": { "type": "string", "minLength": 1 },
        "scanProfileDigest": { "$ref": "#/$defs/digest" },
        "priorDigest": { "$ref": "#/$defs/digest" },
        "nextDigest": { "$ref": "#/$defs/digest" },
        "renameCandidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["priorLocator", "nextLocator", "confidence"],
          "properties": {
            "priorLocator": { "type": "string", "minLength": 1 },
            "nextLocator": { "type": "string", "minLength": 1 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "changeCause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": {
          "enum": [
            "content",
            "provider",
            "schema",
            "ontology",
            "proof-policy",
            "scan-profile",
            "redaction",
            "authorization",
            "manual",
            "unknown"
          ]
        },
        "source": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" }
      }
    }
  }
}
