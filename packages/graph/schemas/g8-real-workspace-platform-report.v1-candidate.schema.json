{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/graph/g8-real-workspace-platform-report/v1-candidate",
  "title": "WorkspaiGraphG8RealWorkspacePlatformReportCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "stage",
    "checkpoint",
    "status",
    "admitted",
    "nextStage",
    "nextStageAuthorized",
    "crossPlatformAdmission",
    "currentGraphAuthority",
    "authorizedRuntimeMode",
    "mappingVersion",
    "inventoryDigest",
    "sourceFixtureDigest",
    "sourceTreeDigest",
    "scopeDigest",
    "providerProfileDigest",
    "graphPolicyDigest",
    "redactionAuthorizationDigest",
    "resourceBudgetDigest",
    "reportDigest",
    "semanticOutputDigest",
    "comparisonStatus",
    "differenceCodes",
    "packageExecutionStatus",
    "environment",
    "platformEvidence",
    "ci",
    "versions",
    "qualification",
    "receipt",
    "failures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "workspai.graph-g8-real-workspace-platform-report.v1-candidate"
    },
    "package": { "const": "@workspai/graph" },
    "stage": { "const": "G8" },
    "checkpoint": { "const": "real-workspace-cross-platform-parity" },
    "status": { "enum": ["passed-platform", "failed"] },
    "admitted": { "const": false },
    "nextStage": { "const": "G9" },
    "nextStageAuthorized": { "const": false },
    "crossPlatformAdmission": { "const": "pending" },
    "currentGraphAuthority": { "const": "official-internal-graph-capability" },
    "authorizedRuntimeMode": { "const": "g8-shadow-comparison-only" },
    "mappingVersion": { "$ref": "#/$defs/mappingVersion" },
    "inventoryDigest": { "$ref": "#/$defs/sha256" },
    "sourceFixtureDigest": { "$ref": "#/$defs/sha256" },
    "sourceTreeDigest": { "$ref": "#/$defs/sha256" },
    "scopeDigest": { "$ref": "#/$defs/sha256" },
    "providerProfileDigest": { "$ref": "#/$defs/sha256" },
    "graphPolicyDigest": { "$ref": "#/$defs/sha256" },
    "redactionAuthorizationDigest": { "$ref": "#/$defs/sha256" },
    "resourceBudgetDigest": { "$ref": "#/$defs/sha256" },
    "reportDigest": { "$ref": "#/$defs/sha256" },
    "semanticOutputDigest": { "$ref": "#/$defs/sha256" },
    "comparisonStatus": {
      "enum": ["equivalent", "different", "incomparable", "failed"]
    },
    "differenceCodes": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "packageExecutionStatus": {
      "enum": ["complete", "partial", "failed", "cancelled", "not-executed"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "node"],
      "properties": {
        "platform": { "enum": ["linux", "darwin", "win32"] },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 32 },
        "node": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "platformEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runnerOs", "runnerArch"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "runnerOs": { "enum": ["Linux", "macOS", "Windows"] },
        "runnerArch": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "runId", "event", "sourceCommit", "testedCommit"],
      "properties": {
        "provider": { "const": "github-actions" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "event": { "enum": ["pull_request", "push"] },
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "testedCommit": { "$ref": "#/$defs/commit" }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli", "graphPackage"],
      "properties": {
        "cli": { "$ref": "#/$defs/versionBinding" },
        "graphPackage": { "$ref": "#/$defs/versionBinding" }
      }
    },
    "qualification": { "$ref": "#/$defs/qualification" },
    "receipt": { "$ref": "#/$defs/receipt" },
    "failures": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "mappingVersion": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^workspai\\.graph-shadow-mapping\\.v[0-9]+$"
    },
    "portableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "versionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "commit": { "$ref": "#/$defs/commit" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "epoch",
        "executionPath",
        "comparison",
        "authority",
        "packageWrites",
        "fallback"
      ],
      "properties": {
        "schemaVersion": {
          "const": "workspai.graph-model-authority-receipt.v1-candidate"
        },
        "epoch": { "const": "package-shadow" },
        "executionPath": { "const": "compared" },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "profile", "reportDigest"],
          "properties": {
            "status": { "enum": ["equivalent", "different", "incomparable", "failed"] },
            "profile": { "type": "string", "minLength": 1, "maxLength": 128 },
            "reportDigest": { "$ref": "#/$defs/sha256" }
          }
        },
        "authority": { "const": "released-cli" },
        "packageWrites": { "const": "prohibited" },
        "fallback": { "const": "prohibited" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "profile",
        "inventoryDigest",
        "mappingVersion",
        "observations",
        "mutatedCanonicalArtifacts",
        "usedProcessCwdAsAuthority",
        "receipt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "workspai.graph-real-workspace-qualification.v1-candidate"
        },
        "profile": { "const": "g8-real-workspace.v1" },
        "inventoryDigest": { "$ref": "#/$defs/sha256" },
        "mappingVersion": { "$ref": "#/$defs/mappingVersion" },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/observation" }
        },
        "mutatedCanonicalArtifacts": { "type": "boolean" },
        "usedProcessCwdAsAuthority": { "type": "boolean" },
        "receipt": { "$ref": "#/$defs/receipt" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "projectId", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/portableId" },
        "kind": { "enum": ["committed-fixture", "local-reference"] },
        "projectId": { "$ref": "#/$defs/portableId" },
        "status": {
          "enum": ["compared", "unavailable-local-observation", "failed"]
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 256 },
        "packageExecution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "inputFiles", "providerFacts"],
          "properties": {
            "status": {
              "enum": ["complete", "partial", "failed", "cancelled", "not-executed"]
            },
            "inputFiles": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "providerFacts": { "type": "integer", "minimum": 0, "maximum": 5000000 }
          }
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "mappingVersion",
            "reportDigest",
            "semanticOutputDigest",
            "sourceTreeDigest",
            "regressions",
            "approvedDifferences",
            "differenceCodes",
            "sourceFixtureDigest",
            "scopeDigest",
            "providerProfileDigest",
            "graphPolicyDigest",
            "redactionAuthorizationDigest",
            "resourceBudgetDigest"
          ],
          "properties": {
            "status": { "enum": ["equivalent", "different", "incomparable", "failed"] },
            "mappingVersion": { "$ref": "#/$defs/mappingVersion" },
            "reportDigest": { "$ref": "#/$defs/sha256" },
            "semanticOutputDigest": { "$ref": "#/$defs/sha256" },
            "sourceTreeDigest": { "$ref": "#/$defs/sha256" },
            "regressions": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "approvedDifferences": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "differenceCodes": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "sourceFixtureDigest": { "$ref": "#/$defs/sha256" },
            "scopeDigest": { "$ref": "#/$defs/sha256" },
            "providerProfileDigest": { "$ref": "#/$defs/sha256" },
            "graphPolicyDigest": { "$ref": "#/$defs/sha256" },
            "redactionAuthorizationDigest": { "$ref": "#/$defs/sha256" },
            "resourceBudgetDigest": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  }
}
