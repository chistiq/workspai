{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/graph/provider-manifest/v0.1.0-candidate",
  "title": "WorkspaiGraphProviderManifestCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "version",
    "displayName",
    "determinism",
    "capabilities",
    "permissions",
    "limits",
    "contractVersions",
    "supportedInputs",
    "incremental",
    "identitySchemes"
  ],
  "properties": {
    "contract": {
      "const": { "id": "workspai.graph.provider-manifest", "version": "0.1.0-candidate" }
    },
    "id": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/identifier" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "determinism": { "enum": ["deterministic", "seeded", "nondeterministic"] },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityKinds",
        "relationKinds",
        "relationSemantics",
        "factFamilies",
        "allowedClaims"
      ],
      "properties": {
        "entityKinds": { "$ref": "#/$defs/nonEmptyIdentifiers" },
        "relationKinds": { "$ref": "#/$defs/nonEmptyIdentifiers" },
        "relationSemantics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["structural", "behavioral", "declarative", "derived"] }
        },
        "factFamilies": { "$ref": "#/$defs/nonEmptyIdentifiers" },
        "allowedClaims": { "$ref": "#/$defs/nonEmptyIdentifiers" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "network", "process", "credentials"],
      "properties": {
        "filesystem": { "enum": ["none", "read"] },
        "network": { "enum": ["deny", "allow"] },
        "process": { "enum": ["deny", "allow"] },
        "credentials": { "const": "deny" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDurationMs", "maxFacts"],
      "properties": {
        "maxDurationMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "maxFacts": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "maxInputBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "contractVersions": { "$ref": "#/$defs/nonEmptyIdentifiers" },
    "supportedInputs": { "$ref": "#/$defs/nonEmptyIdentifiers" },
    "incremental": { "enum": ["none", "input", "native"] },
    "identitySchemes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "version": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z0-9][a-z0-9._:/#@+\\-]*$"
    },
    "nonEmptyIdentifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    }
  }
}
