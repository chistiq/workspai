{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/graph/cli-result/v0.1.0-candidate",
  "title": "WorkspaiGraphCliResultCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "status", "data", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "workspai.graph.cli-result.v1" },
    "command": {
      "enum": ["inspect", "quality", "query", "providers", "input"]
    },
    "status": {
      "enum": ["complete", "partial", "failed", "cancelled"]
    },
    "data": {},
    "diagnostics": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "path", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
