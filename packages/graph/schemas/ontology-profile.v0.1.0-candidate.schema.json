{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/graph/ontology-profile/v0.1.0-candidate",
  "title": "WorkspaiGraphOntologyProfileCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "version", "entities", "relations"],
  "properties": {
    "contract": {
      "const": { "id": "workspai.graph.ontology-profile", "version": "0.1.0-candidate" }
    },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "extends": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "object", "required": ["id", "version"] }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "family"],
        "properties": {
          "kind": { "type": "string" },
          "family": { "type": "string" },
          "extensionNamespace": { "type": "string" }
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "semantics",
          "subjectFamilies",
          "objectFamilies",
          "symmetric",
          "transitive",
          "allowedAuthorities",
          "proofPolicy"
        ],
        "properties": {
          "kind": { "type": "string" },
          "semantics": { "enum": ["structural", "behavioral", "declarative", "derived"] },
          "subjectFamilies": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "objectFamilies": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "inverse": { "type": "string" },
          "symmetric": { "type": "boolean" },
          "transitive": { "type": "boolean" },
          "allowedAuthorities": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["declared", "observed", "verified", "inferred"] }
          },
          "proofPolicy": { "type": "object", "required": ["id", "version"] },
          "extensionNamespace": { "type": "string" }
        }
      }
    }
  }
}
