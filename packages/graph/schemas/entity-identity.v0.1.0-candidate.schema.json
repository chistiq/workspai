{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/graph/entity-identity/v0.1.0-candidate",
  "title": "WorkspaiGraphEntityIdentityCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "identityScheme", "kind", "scope"],
  "properties": {
    "id": { "$ref": "#/$defs/identifier" },
    "identityScheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "workspai.graph.portable-entity" },
        "version": { "const": "1" }
      }
    },
    "kind": { "$ref": "#/$defs/identifier" },
    "scope": { "$ref": "#/$defs/scope" },
    "aliases": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "reason": { "enum": ["rename", "move", "canonicalization", "provider-alias"] }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z0-9][a-z0-9._:/#@+\\-]*$"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "workspaceId"],
          "properties": {
            "kind": { "const": "workspace" },
            "workspaceId": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "projectIds"],
          "properties": {
            "kind": { "const": "project" },
            "workspaceId": { "$ref": "#/$defs/identifier" },
            "projectIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": { "$ref": "#/$defs/identifier" }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "selection" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "organizationId"],
          "properties": {
            "kind": { "const": "organization" },
            "organizationId": { "$ref": "#/$defs/identifier" },
            "workspaceId": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    }
  }
}
