{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/graph/nary-assertion/v0.1.0-candidate",
  "title": "WorkspaiGraphNaryAssertionCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "relation",
    "profile",
    "participants",
    "facts",
    "derivation",
    "state",
    "proof",
    "freshness",
    "confidence"
  ],
  "properties": {
    "contract": {
      "const": { "id": "workspai.graph.nary-assertion", "version": "0.1.0-candidate" }
    },
    "id": { "type": "string", "minLength": 1 },
    "relation": { "type": "string", "minLength": 1 },
    "profile": { "type": "object", "required": ["id", "version"] },
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "entity"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "entity": { "type": "object" },
          "ordinal": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "facts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "derivation": {
      "enum": ["observed", "extracted", "declared", "computed", "inferred", "generated", "imported"]
    },
    "state": { "enum": ["accepted", "disputed", "rejected", "unresolved"] },
    "proof": {
      "type": "object",
      "required": [
        "policy",
        "state",
        "evidence",
        "corroborationGroups",
        "counterEvidence",
        "missingRequirements",
        "evaluatedAt",
        "inputDigest",
        "explanationCode"
      ]
    },
    "freshness": { "type": "object", "required": ["status"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
