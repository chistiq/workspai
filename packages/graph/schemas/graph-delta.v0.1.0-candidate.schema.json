{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/graph/graph-delta/v0.1.0-candidate",
  "title": "WorkspaiGraphDeltaCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "baseGeneration",
    "targetGeneration",
    "changedInputs",
    "affectedProviders",
    "facts",
    "graph",
    "affectedProjections",
    "downstreamInvalidations",
    "execution",
    "equivalence"
  ],
  "properties": {
    "contract": {
      "const": { "id": "workspai.graph.graph-delta", "version": "0.1.0-candidate" }
    },
    "baseGeneration": { "type": "string", "minLength": 1 },
    "targetGeneration": { "type": "string", "minLength": 1 },
    "changedInputs": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/inputChange" }
    },
    "affectedProviders": { "type": "array", "maxItems": 10000, "items": { "type": "string" } },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "renewed", "removed", "invalidated"],
      "properties": {
        "added": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "renewed": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "removed": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "invalidated": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addedNodes",
        "removedNodes",
        "changedNodes",
        "changedEdges",
        "addedAssertions",
        "removedAssertions",
        "changedAssertions"
      ],
      "properties": {
        "addedNodes": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "removedNodes": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "changedNodes": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "changedEdges": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "addedAssertions": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } },
        "removedAssertions": {
          "type": "array",
          "maxItems": 1000000,
          "items": { "type": "string" }
        },
        "changedAssertions": { "type": "array", "maxItems": 1000000, "items": { "type": "string" } }
      }
    },
    "affectedProjections": { "type": "array", "maxItems": 10000, "items": { "type": "string" } },
    "downstreamInvalidations": {
      "type": "array",
      "maxItems": 100000,
      "items": { "type": "string" }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detected",
        "scanned",
        "parsed",
        "recomputed",
        "skippedByDigest",
        "unsupported",
        "failed",
        "truncation",
        "processing"
      ],
      "properties": {
        "detected": { "type": "integer", "minimum": 0 },
        "scanned": { "type": "integer", "minimum": 0 },
        "parsed": { "type": "integer", "minimum": 0 },
        "recomputed": { "type": "integer", "minimum": 0 },
        "skippedByDigest": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "truncation": { "type": "array", "maxItems": 1000, "items": { "type": "object" } },
        "processing": { "type": "array", "maxItems": 1000000, "items": { "type": "object" } }
      }
    },
    "equivalence": {
      "enum": ["pass", "attention", "blocked", "not-assessed"]
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "inputChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "inputKind", "scanProfileDigest"],
      "properties": {
        "kind": {
          "enum": ["added", "edited", "deleted", "renewed", "rename-candidate"]
        },
        "locator": { "type": "string", "minLength": 1 },
        "inputKind": { "type": "string", "minLength": 1 },
        "scanProfileDigest": { "$ref": "#/$defs/digest" },
        "priorDigest": { "$ref": "#/$defs/digest" },
        "nextDigest": { "$ref": "#/$defs/digest" },
        "renameCandidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["priorLocator", "nextLocator", "confidence"],
          "properties": {
            "priorLocator": { "type": "string", "minLength": 1 },
            "nextLocator": { "type": "string", "minLength": 1 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
