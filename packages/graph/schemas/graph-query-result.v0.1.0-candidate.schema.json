{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workspai.dev/graph/query-result/v0.1.0-candidate",
  "title": "WorkspaiGraphQueryResultCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "query",
    "queryDigest",
    "generation",
    "result",
    "paths",
    "evidence",
    "disputes",
    "unknownBoundaries",
    "freshness",
    "confidence",
    "cost",
    "retrievalPlan",
    "utility",
    "quality",
    "analysis",
    "truncation",
    "diagnostics"
  ],
  "properties": {
    "contract": { "const": { "id": "workspai.graph.query-result", "version": "0.1.0-candidate" } },
    "query": { "type": "object" },
    "queryDigest": { "type": "object", "required": ["algorithm", "value"] },
    "generation": { "type": "object", "required": ["id", "generatedAt", "contentDigest"] },
    "result": {},
    "paths": { "type": "array", "maxItems": 1000 },
    "evidence": { "type": "array", "maxItems": 100000 },
    "disputes": { "type": "array", "maxItems": 100000 },
    "unknownBoundaries": { "type": "array", "maxItems": 100000 },
    "freshness": { "type": "object", "required": ["status"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "cost": {
      "type": "object",
      "required": ["visitedNodes", "visitedEdges", "returnedPaths", "returnedEvidence"]
    },
    "retrievalPlan": {
      "type": "object",
      "required": ["contract", "profile", "candidates", "selected", "budget"]
    },
    "utility": {
      "type": "object",
      "required": ["profile", "baseline", "status", "sufficient", "drivers", "limitations"]
    },
    "quality": { "type": "object", "required": ["proofStates", "bindingCompleteness"] },
    "analysis": {
      "type": "object",
      "required": [
        "profile",
        "algorithm",
        "sourceGeneration",
        "proofThreshold",
        "capability",
        "circularity",
        "accuracyClaim",
        "drivers",
        "limitations",
        "validationEvidence"
      ]
    },
    "truncation": { "type": "object", "required": ["truncated", "reasons"] },
    "diagnostics": { "type": "array", "maxItems": 100000 }
  }
}
