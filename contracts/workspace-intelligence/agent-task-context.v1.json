{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspai.dev/schemas/workspace-intelligence/agent-task-context.v1.json",
  "title": "Workspai bounded agent task context",
  "description": "Read-only task entry packet combining canonical project grounding, scoped Graph discovery and closest manifest-derived lifecycle guidance. Missing Workspai evidence is explicit and does not block native project work.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "task",
        "scope",
        "grounding",
        "graph",
        "lifecycle",
        "operatingRules",
        "nextActions",
        "budget",
        "integrity"
      ],
      "properties": {
        "schemaVersion": { "const": "workspai.agent-task-context.v1" },
        "status": { "enum": ["ready", "partial"] },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "use", "authority"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "use": { "const": "retrieval-query" },
            "authority": { "const": "user-request" }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "projectPath", "workspace", "binding"],
          "properties": {
            "project": { "type": "string", "minLength": 1 },
            "projectPath": { "type": "string", "minLength": 1 },
            "workspace": { "type": ["string", "null"] },
            "binding": { "enum": ["canonical-project-member", "not-workspai-managed"] }
          }
        },
        "grounding": {
          "oneOf": [{ "$ref": "agent-bootstrap-view.v1.json" }, { "$ref": "#/$defs/unavailable" }]
        },
        "graph": {
          "oneOf": [
            { "$ref": "workspace-graph-search-view.v1.json" },
            { "$ref": "#/$defs/unavailable" }
          ]
        },
        "lifecycle": { "$ref": "https://workspai.dev/contracts/project-lifecycle-context.v1.json" },
        "operatingRules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "nextActions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxBytes", "usedBytes", "accounting"],
          "properties": {
            "maxBytes": { "type": "integer", "minimum": 8192, "maximum": 131072 },
            "usedBytes": { "type": "integer", "minimum": 1 },
            "accounting": { "const": "utf8-json-with-newline" }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "payloadHash"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "payloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status", "budget", "message", "nextActions"],
      "properties": {
        "schemaVersion": { "const": "workspai.agent-task-context.v1" },
        "status": { "const": "insufficient-budget" },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxBytes", "requiredBytes", "accounting"],
          "properties": {
            "maxBytes": { "type": "integer", "minimum": 8192, "maximum": 131072 },
            "requiredBytes": { "type": "integer", "minimum": 1 },
            "accounting": { "const": "utf8-json-with-newline" }
          }
        },
        "message": { "type": "string", "minLength": 1 },
        "nextActions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "$defs": {
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "nextAction"],
      "properties": {
        "status": { "const": "unavailable" },
        "reason": { "type": "string", "minLength": 1 },
        "nextAction": { "type": "string", "minLength": 1 },
        "inputValidation": { "$ref": "agent-bootstrap-receipt.v1.json#/$defs/inputValidation" }
      }
    }
  }
}
