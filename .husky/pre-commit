#!/usr/bin/env sh

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

run_without_git_hook_env() {
	env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX "$@"
}

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
CHECK_SHARED_CONTRACTS=false
CHECK_CORE_CONTRACTS=false
CHECK_DOCS=false

echo "Checking staged files for English-only authored text..."
corepack npm run check:english-text:staged || exit 1

while IFS= read -r file; do
	case "$file" in
		contracts/* | packages/cli/contracts/* | packages/cli/src/contracts/* | packages/cli/scripts/sync-shared-contracts.mjs | packages/cli/scripts/generate-shared-contracts.mjs | packages/cli/scripts/check-agent-customization-drift.mjs)
			CHECK_SHARED_CONTRACTS=true
			;;
		packages/cli/docs/contracts/* | packages/cli/scripts/sync-contracts.mjs)
			CHECK_CORE_CONTRACTS=true
			;;
	esac

	case "$file" in
		*.md | packages/cli/package.json | packages/cli/src/index.ts | packages/cli/scripts/docs-drift-guard.mjs | packages/cli/scripts/github-release-notes.mjs | packages/cli/scripts/discord-release-announcement.mjs)
			CHECK_DOCS=true
			;;
	esac
done <<EOF
$STAGED_FILES
EOF

echo "🧹 Checking staged TypeScript..."
corepack npm --workspace workspai exec lint-staged || exit 1

if [ "$CHECK_SHARED_CONTRACTS" = true ]; then
	echo "📋 Regenerating and synchronizing changed contracts..."
	run_without_git_hook_env corepack npm --workspace workspai run sync:shared-contracts -- --stage-git || {
		echo "❌ Contract synchronization failed."
		exit 1
	}
	echo "📋 Verifying generated and consumer contract parity..."
	run_without_git_hook_env corepack npm --workspace workspai run check:shared-contracts || {
		echo "❌ Shared contract drift detected."
		exit 1
	}
	run_without_git_hook_env corepack npm --workspace workspai run check:generated-contracts || {
		echo "❌ Generated contract drift detected."
		exit 1
	}
	run_without_git_hook_env corepack npm --workspace workspai run check:agent-customization-drift || {
		echo "❌ Agent customization contract drift detected."
		exit 1
	}
fi

if [ "$CHECK_CORE_CONTRACTS" = true ]; then
	echo "📋 Verifying Core compatibility contract parity..."
	run_without_git_hook_env corepack npm --workspace workspai run check:contracts || {
		echo "❌ Core compatibility contract drift detected."
		echo "   Synced files were staged where possible; review both repositories."
		exit 1
	}
fi

if [ "$CHECK_DOCS" = true ]; then
	echo "📚 Checking documentation and release-state drift..."
	run_without_git_hook_env corepack npm --workspace workspai run check:docs-drift || exit 1
fi

echo "✅ Staged checks passed. Full local validation runs at pre-push."
